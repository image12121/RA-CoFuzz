# Recovered configuration for the reported historical RA-CoFuzz Hybrid runs.
# This file contains no credentials or machine-local paths.
GPTFUZZ_RA_MODE=1
GPTFUZZ_STRONG_JUDGE_IN_LOOP=1
GPTFUZZ_HYBRID_WARMUP_STEPS=2
GPTFUZZ_HYBRID_MCTS_RATIO=0.50
GPTFUZZ_HYBRID_DP_RATIO=0.30
GPTFUZZ_HYBRID_ELITE_RATIO=0.20
GPTFUZZ_HYBRID_DP_ALPHA=0.5
GPTFUZZ_HYBRID_DP_EPSILON=0.10
GPTFUZZ_HYBRID_DP_TOPK=5
GPTFUZZ_HYBRID_ELITE_TOPK=5

# The separate six-term development score was disabled in the final runs.
GPTFUZZ_RAES_MODE=0
GPTFUZZ_REVIEW_QUOTA_RATE=0
GPTFUZZ_LEGACY_EXPAND_DOUBLE_CONCAT=0
