# Never commit real credentials or private model paths.
CUDA_VISIBLE_DEVICES=0
PREDICTOR_DEVICE=cpu
TARGET_MAX_GPU_MEMORY=22GiB

TARGET_LLAMA=/path/to/Llama-3.2-3B-Instruct
TARGET_QWEN15=/path/to/Qwen2.5-1.5B-Instruct
TARGET_QWEN3=/path/to/Qwen2.5-3B-Instruct
TARGET_QWEN=/path/to/Qwen2.5-7B-Instruct
TARGET_VICUNA=/path/to/vicuna-7b-v1.5

MUTATION_API_KEY=replace_with_authorized_key
RACOFUZZ_API_KEY=replace_with_authorized_key
EASYJAILBREAK_API_KEY=replace_with_authorized_key
MUTATION_API_BASE_URL=https://api.deepseek.com/v1
RACOFUZZ_API_BASE_URL=https://api.deepseek.com/v1
EASYJAILBREAK_API_BASE_URL=https://api.example.invalid/v1
MUTATION_API_MODEL_NAME=deepseek-chat
RACOFUZZ_API_MODEL_NAME=deepseek-chat
EASYJAILBREAK_API_MODEL_NAME=replace_with_model_name

RACOFUZZ_MAX_QUERY=200
RACOFUZZ_QUESTION_LIMIT=-1
RACOFUZZ_TARGET_MAX_NEW_TOKENS=128
# New runs use these requested seeds. Historical public results retain the
# same values as run labels; see docs/EXPERIMENT_PROTOCOL.md.
RACOFUZZ_RUN_SEEDS="100 200 300"
